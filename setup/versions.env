# Pins for setup/install.sh. Sourced by install.sh; plain KEY=value lines.
# Every non-vendor-repo version lives here. Each task appends its own pins;
# nothing rewrites another task's entries. AI/agent CLIs are not pinned.

# Task 4: essential CLI tools, git TUIs, tmux build.
# GITUI_VERSION is the latest stable release at implementation time (2026-10).
NVIM_VERSION=0.12.2
FZF_VERSION=0.67.0
LAZYGIT_VERSION=0.64.0
LAZYDOCKER_VERSION=0.24.2
EZA_VERSION=0.20.10
GITUI_VERSION=0.28.1
TMUX_VERSION=3.6a

# Task 5: zsh, oh-my-zsh, plugins, prompts. Full SHAs (git_pin refuses short ones).
# oh-my-zsh auto-update is disabled in zsh/.zshrc-linux: these pins are the only source of truth.
# STARSHIP_VERSION is the latest release at implementation time (2026-10); its .sha256 is verified.
OMZ_SHA=4d4cfc287e9d887b81242c0e431b5f49f9cec5c1
P10K_SHA=bbea8d2d06382f6f0001c9212da91a319076f06e
FZF_TAB_SHA=14e16f0d36ae9938e28b2f6efdb7344cd527a1a6
ZSH_AUTOSUGGESTIONS_SHA=a411ef3e0992d4839f0732ebeb9823024afaaaa8
ZSH_SYNTAX_HIGHLIGHTING_SHA=caa749d030d22168445c4cb97befd406d2828db0
ZSH_VI_MODE_SHA=287efa19ec492b2f24bb93d1f4eaac3049743a63
ZSH_COMPLETIONS_SHA=7a884c75b4f3ce2d8d24df8e55dcc359a020be3f
STARSHIP_VERSION=1.27.0

# Task 6: tmux plugins (full SHAs) and zellij.
# ZELLIJ_VERSION is the latest release at implementation time (2026-10); the hash of the
# extracted binary is verified against the release's .sha256sum file.
TPM_SHA=99469c4a9b1ccf77fade25842dc7bafbc8ce9946
TMUX_SENSIBLE_SHA=25cb91f42d020f675bb0a2ce3fbd3a5d96119efa
TMUX_YANK_SHA=acfd36e4fcba99f8310a7dfb432111c242fe7392
TMUX_RESURRECT_SHA=cff343cf9e81983d3da0c8562b01616f12e8d548
TMUX_NORD_SHA=f7b6da07ab55fe32ee5f7d62da56d8e5ac691a92
ZELLIJ_VERSION=0.45.1

# Task 8: full profile CLI extras (releases; none of them publishes checksums).
# YAZI_VERSION is the latest release at implementation time (2026-10). At pin time yazi was
# started in a tmux pane with the repo config (it started) and with a deliberately broken
# theme.toml (it printed "Failed to parse config"). Loading the onedark flavor cannot be
# verified this way. When bumping YAZI_VERSION, repeat that check by hand: run
# `tmux new -d 'yazi /tmp'`, then `tmux capture-pane -p`.
XH_VERSION=0.23.1
FASTFETCH_VERSION=2.70.0
YAZI_VERSION=26.9.1

# Task 9: runtimes via mise, and Rust.
# MISE_VERSION is the latest release at implementation time (2026-10); the binary is verified
# against the release's SHASUMS256.txt. MISE_NODE and MISE_GO: first entry is the default.
# SPECKIT_TAG is the tag for specify-cli 0.0.22. cargo-binstall publishes only minisign
# signatures, no checksum file, so it is pinned by URL only.
MISE_VERSION=2026.10.19
MISE_NODE="22 24"
MISE_PYTHON=3.12.7
MISE_GO="1.27.3 1.23.4"
MISE_BUN=1.3.14
MISE_PNPM=9.15.0
MISE_UV=0.5.7
CHISEL_VERSION=1.11.3
SQLC_VERSION=1.31.1
POSTING_VERSION=2.3.0
SPECKIT_TAG=v0.0.22
RUST_VERSION=1.99.0
CARGO_BINSTALL_VERSION=1.26.1
SCCACHE_VERSION=0.18.0
NEXTEST_VERSION=0.9.146
CARGO_DENY_VERSION=0.20.2
WATCHEXEC_VERSION=2.7.3
OHA_VERSION=1.16.0
SQLX_CLI_VERSION=0.9.0
TAURI_DRIVER_VERSION=2.0.1
